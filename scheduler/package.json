{
  "name": "gitfather-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cloudflare Worker that schedules the-gitfather client backups/verifies via GitHub workflow_dispatch (replaces GitHub Actions cron).",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "typecheck": "tsc --noEmit",
    "config:pull": "scripts/pull-config.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "typescript": "^5.7.2",
    "wrangler": "^4"
  }
}
